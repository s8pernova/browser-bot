[Unit]
Description=Browser Bot Playwright Automation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{EXEC_USER}}
Group={{EXEC_USER}}
WorkingDirectory={{PROJECT_ROOT}}
EnvironmentFile=-{{PROJECT_ROOT}}/ops/.env
ExecStart={{PROJECT_ROOT}}/.venv/bin/python -m app.cli --run -f {{WORKFLOW_FILE}}
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target